<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Forma conecta tu iPhone con tu Mac para enviar las fuentes del escaneo y procesarlas en tu propia computadora.</string>
    <key>NSBonjourServices</key>
    <array><string>_forma-rgbd._tcp</string></array>
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>NSSupportsLiveActivities</key>
    <true/>
    <key>CFBundleURLTypes</key>
    <array><dict>
        <key>CFBundleURLName</key><string>com.robii.forma.processing</string>
        <key>CFBundleURLSchemes</key><array><string>forma</string></array>
    </dict></array>
    <key>UIBackgroundModes</key>
    <array><string>processing</string></array>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array><string>com.robii.forma.processing.*</string></array>
</dict>
</plist>
