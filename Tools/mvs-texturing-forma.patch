diff --git a/apps/texrecon/forma_geometry_receipt.h b/apps/texrecon/forma_geometry_receipt.h
new file mode 100644
index 0000000..c6ac86d
--- /dev/null
+++ b/apps/texrecon/forma_geometry_receipt.h
@@ -0,0 +1,55 @@
+// Forma's geometry-order receipt. SHA inputs are canonical little-endian Float32 XYZ
+// and UInt32 face indices, with no SIMD padding, normal data or PLY list-size bytes.
+#ifndef FORMA_GEOMETRY_RECEIPT_H
+#define FORMA_GEOMETRY_RECEIPT_H
+#include <CommonCrypto/CommonDigest.h>
+#include <cstdint>
+#include <cstring>
+#include <fstream>
+#include <iomanip>
+#include <sstream>
+#include <stdexcept>
+#include <mve/mesh.h>
+namespace forma {
+struct Digest {
+    CC_SHA256_CTX state;
+    Digest() { CC_SHA256_Init(&state); }
+    void bytes(void const* p, std::size_t n) { while (n) { CC_LONG k=static_cast<CC_LONG>(std::min<std::size_t>(n, 1<<20)); CC_SHA256_Update(&state,p,k);p=static_cast<char const*>(p)+k;n-=k; } }
+    void u32(std::uint32_t v) { unsigned char p[4]={static_cast<unsigned char>(v),static_cast<unsigned char>(v>>8),static_cast<unsigned char>(v>>16),static_cast<unsigned char>(v>>24)};bytes(p,4); }
+    std::string finish() { unsigned char digest[CC_SHA256_DIGEST_LENGTH];CC_SHA256_Final(digest,&state);std::ostringstream s;for(auto c:digest)s<<std::hex<<std::setfill('0')<<std::setw(2)<<int(c);return s.str(); }
+};
+inline std::string file_sha(std::string const& path) {
+    std::ifstream f(path,std::ios::binary);if(!f)throw std::runtime_error("Could not hash input/output file: "+path);
+    Digest d;char b[1<<16];while(f){f.read(b,sizeof(b));d.bytes(b,static_cast<std::size_t>(f.gcount()));}if(!f.eof())throw std::runtime_error("File hash read failed: "+path);return d.finish();
+}
+inline std::string vertex_sha(mve::TriangleMesh::Ptr const& mesh) {
+    static_assert(sizeof(float)==4,"Float32 geometry required");Digest d;
+    for(auto const& v:mesh->get_vertices())for(int i=0;i<3;++i){std::uint32_t bits;float f=v[i];std::memcpy(&bits,&f,4);d.u32(bits);}return d.finish();
+}
+inline std::string face_sha(mve::TriangleMesh::Ptr const& mesh) {
+    Digest d;for(auto v:mesh->get_faces()){if(static_cast<std::uint64_t>(v)>UINT32_MAX)throw std::runtime_error("Face index is not UInt32 representable");d.u32(static_cast<std::uint32_t>(v));}return d.finish();
+}
+struct GeometryReceipt {
+    std::string inputSHA,beforeVertex,afterVertex,beforeFace,afterFace;
+    std::size_t vertexCount=0,faceCount=0,outputVertexCount=0,outputFaceCount=0;
+    void before(std::string const& file,mve::TriangleMesh::Ptr const& mesh) { inputSHA=file_sha(file);vertexCount=mesh->get_vertices().size();faceCount=mesh->get_faces().size()/3;beforeVertex=vertex_sha(mesh);beforeFace=face_sha(mesh); }
+    void after(mve::TriangleMesh::Ptr const& mesh) { outputVertexCount=mesh->get_vertices().size();outputFaceCount=mesh->get_faces().size()/3;afterVertex=vertex_sha(mesh);afterFace=face_sha(mesh); }
+    bool unchanged() const { return vertexCount==outputVertexCount&&faceCount==outputFaceCount&&beforeVertex==afterVertex&&beforeFace==afterFace; }
+    void write(std::string const& path,std::size_t views,std::string const& labels,std::string const& status) const {
+        static_assert(sizeof(std::size_t)==8,"Forma labels ABI requires size_t64");
+        std::string labelsSHA; if(!labels.empty()) { std::ifstream f(labels,std::ios::binary|std::ios::ate);if(!f || f.tellg()!=static_cast<std::streamoff>(faceCount*8))throw std::runtime_error("Label byte count does not match geometry");labelsSHA=file_sha(labels); }
+        std::ofstream f(path+".partial",std::ios::binary|std::ios::trunc);if(!f)throw std::runtime_error("Cannot create geometry receipt");
+        f<<"{\n\"schemaVersion\":1,\"workerABI\":\"FORMA_LABELS_ONLY_V1\",\"status\":\""<<status<<"\",\n"
+         <<"\"inputMeshSHA256\":\""<<inputSHA<<"\",\n"
+         <<"\"calledProductionPrepareMesh\":true,\"vertexCount\":"<<vertexCount<<",\"faceCount\":"<<faceCount<<",\n"
+         <<"\"inputFaceCount\":"<<faceCount<<",\"outputFaceCount\":"<<outputFaceCount<<",\"outputVertexCount\":"<<outputVertexCount<<",\"removedFaces\":"<<(static_cast<std::int64_t>(faceCount)-static_cast<std::int64_t>(outputFaceCount))<<",\n"
+         <<"\"faceIndexOrderExact\":"<<(beforeFace==afterFace&&faceCount==outputFaceCount?"true":"false")<<",\"worldVerticesExact\":"<<(beforeVertex==afterVertex&&vertexCount==outputVertexCount?"true":"false")<<",\n"
+         <<"\"beforeVertexSHA256\":\""<<beforeVertex<<"\",\"afterVertexSHA256\":\""<<afterVertex<<"\",\n"
+         <<"\"beforeFaceIndexSHA256\":\""<<beforeFace<<"\",\"afterFaceIndexSHA256\":\""<<afterFace<<"\",\n"
+         <<"\"labelCount\":"<<(labels.empty()?0:faceCount)<<",\"labelElementBytes\":8,\"labelByteOrder\":\"littleEndian\",\"labelsSHA256\":\""<<labelsSHA<<"\",\n"
+         <<"\"labelToView\":\"zero=unassigned;N=viewIndex(N-1)\",\"textureViewCount\":"<<views<<",\"UVOrAtlasGenerated\":false\n}\n";
+        f.close();if(!f)throw std::runtime_error("Geometry receipt write failed");if(std::rename((path+".partial").c_str(),path.c_str())!=0)throw std::runtime_error("Geometry receipt publication failed");
+    }
+};
+}
+#endif
diff --git a/libs/tex/forma_radial_projection.h b/libs/tex/forma_radial_projection.h
new file mode 100644
index 0000000..9b5d805
--- /dev/null
+++ b/libs/tex/forma_radial_projection.h
@@ -0,0 +1,76 @@
+#ifndef FORMA_RADIAL_PROJECTION_H
+#define FORMA_RADIAL_PROJECTION_H
+
+#include <algorithm>
+#include <cmath>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+// Optional native radial projection for mvs-texturing. Coordinates are pixel
+// centers with (0,0) at the top-left pixel, after MVE's -0.5 convention correction.
+// This maps a pinhole projection to a measured photo pixel; it never rewrites,
+// resizes, crops, or undistorts the photograph.
+class FormaRadialProjection {
+public:
+    void load_optional(std::string const& image_path, int width, int height) {
+        std::size_t dot = image_path.find_last_of('.');
+        std::string path = image_path.substr(0, dot) + ".forma-lut";
+        std::ifstream input(path.c_str());
+        if (!input) return;
+        std::string magic;
+        int recorded_width = 0, recorded_height = 0;
+        std::size_t count = 0;
+        input >> magic >> recorded_width >> recorded_height >> cx >> cy >> rmax >> count;
+        if (!input || magic != "FORMA_RADIAL_LUT_V1" || recorded_width != width ||
+            recorded_height != height || count < 2 || !std::isfinite(cx) ||
+            !std::isfinite(cy) || !std::isfinite(rmax) || rmax <= 0 ||
+            cx < 0 || cy < 0 || cx > width - 1 || cy > height - 1)
+            throw std::runtime_error("Invalid Forma radial LUT header: " + path);
+        double expected = std::hypot(std::max(cx, width - cx), std::max(cy, height - cy));
+        if (std::abs(rmax - expected) > 1e-7 * expected)
+            throw std::runtime_error("Forma radial LUT radius disagrees with photo dimensions: " + path);
+        // Read incrementally; a corrupt declared count cannot preallocate memory.
+        for (std::size_t i = 0; i < count; ++i) {
+            double value = 0;
+            if (!(input >> value) || !std::isfinite(value) || value <= -1)
+                throw std::runtime_error("Invalid Forma radial LUT sample: " + path);
+            values.push_back(value);
+        }
+        std::string extra;
+        if (input >> extra) throw std::runtime_error("Unexpected Forma radial LUT data: " + path);
+        // A physical radial camera must preserve radial ordering throughout each
+        // piecewise-linear magnification segment, including between LUT samples.
+        double step = rmax / (values.size() - 1);
+        for (std::size_t i = 0; i + 1 < values.size(); ++i) {
+            double r = step * i, slope = (values[i + 1] - values[i]) / step;
+            double start_derivative = 1 + values[i] + r * slope;
+            double end_derivative = 1 + values[i + 1] + (r + step) * slope;
+            if (start_derivative <= 0 || end_derivative <= 0)
+                throw std::runtime_error("Non-monotonic Forma radial LUT: " + path);
+        }
+    }
+
+    void project(float& x, float& y) const {
+        if (values.empty() || !std::isfinite(x) || !std::isfinite(y)) return;
+        double dx = double(x) - cx, dy = double(y) - cy;
+        double coordinate = std::hypot(dx, dy) * (values.size() - 1) / rmax;
+        double magnification = values.back();
+        if (coordinate < values.size() - 1) {
+            std::size_t index = static_cast<std::size_t>(coordinate);
+            double fraction = coordinate - index;
+            magnification = values[index] * (1 - fraction) + values[index + 1] * fraction;
+        }
+        x = static_cast<float>(cx + dx * (1 + magnification));
+        y = static_cast<float>(cy + dy * (1 + magnification));
+    }
+
+    bool enabled() const { return !values.empty(); }
+
+private:
+    double cx = 0, cy = 0, rmax = 0;
+    std::vector<double> values;
+};
+
+#endif
